@using MemoryLeakDetector.API.Models
@using MemoryLeakDetector.Core.Contracts
@model MonitoringReportViewModel
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Отчёт по мониторингу памяти</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #0b1120; color: #f9fafb; margin: 0; padding: 24px; }
        h1, h2 { color: #f9fafb; margin-bottom: 8px; }
        .subtitle { opacity: 0.7; margin-bottom: 24px; }
        .card { background: #020617; border-radius: 12px; padding: 16px 20px; margin-bottom: 16px; border: 1px solid #1e293b; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
        .label { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; opacity: .7; }
        .value { font-size: 20px; font-weight: 600; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px; }
        th, td { padding: 8px 10px; border-bottom: 1px solid #1f2937; text-align: left; }
        th { background: #020617; font-weight: 600; }
        tr:nth-child(even) td { background: #020617; }
        .chip { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; }
        .chip-leak { background: #7f1d1d; color: #fecaca; }
        .chip-ok { background: #064e3b; color: #bbf7d0; }
        .muted { opacity: 0.7; }
    </style>
</head>
<body>
    <h1>Отчёт по мониторингу памяти</h1>
    <div class="subtitle">
        Сгенерирован: @Model.GeneratedAtUtc.ToLocalTime():g<br />
        Период:
        @if (Model.From is null && Model.To is null)
        {
            <span class="muted">все доступные данные</span>
        }
        else
        {
            <span class="muted">
                @Model.From?.ToLocalTime():g — @Model.To?.ToLocalTime():g
            </span>
        }
    </div>

    <div class="card">
            @{
                var summaryLast = Model.Results.LastOrDefault();
                var summaryTotalCycles = Model.Results.Count;
                var summaryTotalProcesses = summaryLast?.Processes.Count ?? 0;
                var summaryTotalLeaks = summaryLast?.Insights.Count(i => i.IsLeakSuspected) ?? 0;
                var summaryTotalErrors = Model.Results.Sum(r => r.ErrorCount);
            }

            <div class="grid">
                <div>
                    <div class="label">Всего циклов</div>
                    <div class="value">@summaryTotalCycles</div>
                </div>
                <div>
                    <div class="label">Всего процессов (последний цикл)</div>
                    <div class="value">@summaryTotalProcesses</div>
                </div>
                <div>
                    <div class="label">Подозрения на утечки (последний цикл)</div>
                    <div class="value">@summaryTotalLeaks</div>
                </div>
                <div>
                    <div class="label">Ошибки (суммарно)</div>
                    <div class="value">@summaryTotalErrors</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Results.Any())
    {
        var latest = Model.Results.Last();
        <div class="card">
            <h2>Последний цикл мониторинга (@latest.StartedUtc.ToLocalTime():g)</h2>
            <div class="muted">Длительность: @latest.Duration</div>

            <table>
                <thead>
                    <tr>
                        <th>Процесс</th>
                        <th>PID</th>
                        <th>Working Set (MB)</th>
                        <th>Virtual (MB)</th>
                        <th>Handles</th>
                        <th>CPU %</th>
                        <th>Leak?</th>
                        <th>Причина</th>
                    </tr>
                </thead>
                <tbody>
                @{
                    var insightsByPid = latest.Insights.ToDictionary(i => i.ProcessId, i => i);
                    foreach (var p in latest.Processes.OrderByDescending(p => p.WorkingSetMb).Take(50))
                    {
                        insightsByPid.TryGetValue(p.ProcessId, out var insight);
                        <tr>
                            <td>@p.ProcessName</td>
                            <td>@p.ProcessId</td>
                            <td>@p.WorkingSetMb:F0</td>
                            <td>@p.VirtualMemoryMb:F0</td>
                            <td>@p.HandleCount</td>
                            <td>@(p.CpuUsagePercent?.ToString("F1") ?? "-")</td>
                            <td>
                                @if (insight?.IsLeakSuspected == true)
                                {
                                    <span class="chip chip-leak">Leak</span>
                                }
                                else
                                {
                                    <span class="chip chip-ok">OK</span>
                                }
                            </td>
                            <td class="muted">@insight?.Reason</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card">
            <span class="muted">Данные мониторинга отсутствуют.</span>
        </div>
    }
</body>
</html>


