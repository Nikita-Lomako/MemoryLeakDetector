<Application x:Class="MemoryLeakDetector.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MemoryLeakDetector.UI.Views"
             xmlns:vm="clr-namespace:MemoryLeakDetector.UI.ViewModels"
             xmlns:converters="clr-namespace:MemoryLeakDetector.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#1E293B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#14213D" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1F2937" />

            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SecondarySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="MinWidth" Value="160" />
            </Style>

            <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Opacity" Value="0.7" />
            </Style>

            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
                <views:ProcessesView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
