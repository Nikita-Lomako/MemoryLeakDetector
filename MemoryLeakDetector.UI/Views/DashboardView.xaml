<UserControl x:Class="MemoryLeakDetector.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,16">
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Всего процессов"
                               Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding TotalProcesses}"
                               Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Мониторится"
                               Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding TrackedProcesses}"
                               Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Активные алерты"
                               Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding ActiveAlerts}"
                               Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>

            <Button Content="Обновить"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right"
                    Margin="16,0,0,0"
                    Padding="20,12" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Топ потребителей памяти"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding TopConsumers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding WorkingSetMb, StringFormat={}{0:F0} MB}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding GrowthPercentage, StringFormat={}{0:F1}%}"
                                           Foreground="{Binding IsLeakSuspected, Converter={StaticResource BooleanToBrushConverter}}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding UpdatedAt, StringFormat={}{0:HH:mm:ss}}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                CornerRadius="8">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Сводный тренд памяти"
                               FontSize="18"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding LastUpdated, StringFormat=Обновлено {0:G}}"
                               Opacity="0.6"
                               DockPanel.Dock="Right" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding MemoryTrend}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding WorkingSetMb, StringFormat={}{0:F0} MB}"
                                           HorizontalAlignment="Right"
                                           Margin="24,0,0,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding VirtualMemoryMb, StringFormat={}{0:F0} MB VM}"
                                           HorizontalAlignment="Right"
                                           Margin="24,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

