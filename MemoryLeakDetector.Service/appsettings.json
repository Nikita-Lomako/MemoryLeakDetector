{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MonitoringPipe": {
    "PipeName": "MemoryLeakDetectorPipe",
    "MaxServerConnections": 8,
    "ClientConnectTimeoutMs": 15000,
    "ReconnectDelayMilliseconds": 2000
  },
  "Monitoring": {
    "PollingIntervalMilliseconds": 1000,
    "BaselineWindow": 120,
    "WorkingSetLeakThresholdPercent": 14.0,
    "WorkingSetLeakThresholdMb": 50.0,
    "VirtualMemoryLeakThresholdPercent": 24.0,
    "HandleLeakThresholdPercent": 20.0,
    "MinSamplesForLeakDetection": 8,
    "IncludeSystemProcesses": false,
    "LeakConfirmationCycles": 3,
    "UseMedianForBaseline": true,
    "EnableTrendAnalysis": true
  }
}
